# ── Supabase ──
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Database (direct connection — required for scripts) ──
DB_HOST=db.xxxxxxxxxxxxxxx.supabase.co
SUPABASE_DB_PASSWORD=your-db-password

# ── Stripe ──
STRIPE_SECRET_KEY=sk_live_***
STRIPE_WEBHOOK_SECRET=whsec_***
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_***

# ── AI Providers ──
OPENAI_API_KEY=sk-***
CLAUDE_API_KEY=sk-ant-***
GEMINI_API_KEY=***
DEEPSEEK_API_KEY=sk-***
OLLAMA_BASE_URL=http://localhost:11434
OPENROUTER_API_KEY=sk-or-***
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_ESSENCE_MODEL=anthropic/claude-sonnet-4-20250514
OPENROUTER_ZURI_MODEL=anthropic/claude-sonnet-4-20250514
ZURI_MODEL=gpt-4.1-mini
ESSENCE_AI_PROVIDER=openrouter
ESSENCE_AI_MODEL=anthropic/claude-sonnet-4-20250514

# ── MCP Servers ──
N8N_MCP_TOKEN=

# Shared secret for internal scheduled workflows (n8n cron jobs like
# WF-102/103/104) to call authenticated API routes without a browser
# session. Generate a long random value; must match on both the Next.js
# app and the n8n workflow's INTERNAL_CRON_SECRET env var.
INTERNAL_CRON_SECRET=
N8N_API_KEY=
GITHUB_TOKEN=github_pat_***

# ── n8n Workflow Automation ──
# All n8n vars should point to the SAME host. Production: automation.evolvededen.com
N8N_URL=https://automation.evolvededen.com
N8N_BASE_URL=https://automation.evolvededen.com
N8N_PUBLIC_API_URL=https://automation.evolvededen.com
N8N_MCP_URL=https://automation.evolvededen.com
N8N_PUBLIC_API_KEY=
N8N_ENCRYPTION_KEY=your-n8n-encryption-key
N8N_METRICS=false

# ── Media Pipeline ──
VOISPARK_API_KEY=vs_***

# ── Sentry Error Tracking ──
SENTRY_DSN=https://xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx@oXXXXXX.ingest.us.sentry.io/XXXXXX
NEXT_PUBLIC_SENTRY_DSN=https://xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx@oXXXXXX.ingest.us.sentry.io/XXXXXX

# ── Resend (Transactional Emails) ──
RESEND_API_KEY=re_***

# ── Deployment (Coolify / Vercel) ──
NEXT_PUBLIC_APP_URL=https://yourdomain.com
NEXT_PUBLIC_SITE_URL=https://yourdomain.com
NEXT_PUBLIC_SERVICES_URL=https://evolvededen.com/services
NEXT_PUBLIC_EXCHANGE_URL=https://evolvededen.com/exchange

# ── Docker Compose (local dev only) ──
POSTGRES_PASSWORD=local-dev-password
PGADMIN_DEFAULT_PASSWORD=local-dev-password
