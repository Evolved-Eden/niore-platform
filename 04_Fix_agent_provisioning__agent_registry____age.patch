---
 app/api/agents/[id]/route.ts    | 2 +-
 app/api/stripe/webhook/route.ts | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/app/api/agents/[id]/route.ts b/app/api/agents/[id]/route.ts
index 81e3279..3c8bac9 100644
--- a/app/api/agents/[id]/route.ts
+++ b/app/api/agents/[id]/route.ts
@@ -9,7 +9,7 @@ export async function GET(
   const supabase = await createAdminClient()
 
   const { data, error } = await supabase
-    .from('agent_registry')
+    .from('agent_catalog')
     .select('*')
     .eq('agent_id', id)
     .single()
diff --git a/app/api/stripe/webhook/route.ts b/app/api/stripe/webhook/route.ts
index 0ae66b2..acb9614 100644
--- a/app/api/stripe/webhook/route.ts
+++ b/app/api/stripe/webhook/route.ts
@@ -238,7 +238,7 @@ async function createZuriAgent(userId: string, orgId: string) {
 
 async function lookupAgentRegistry(agentIds: string[]) {
   const { data: agents } = await supabaseAdmin
-    .from('agent_registry')
+    .from('agent_catalog')
     .select('*')
     .in('agent_id', agentIds)
 
