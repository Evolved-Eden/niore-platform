+/**
+ * HOTFIX (role-lookup-silent-RLS-filter incident): setSessionCookies() above
+ * writes the raw signed JWT into a custom-named cookie. That's enough for
+ * wrapGetUser() (lib/supabase/middleware.ts, lib/supabase/server.ts) to
+ * verify the session locally and avoid the original login-hang bug -- but
+ * it is NOT the session envelope @supabase/ssr's createServerClient expects
+ * to parse back out of a cookie. Without a real @supabase/ssr session, the
+ * underlying PostgREST client has no Authorization header to attach on
+ * .from() calls and silently executes them as the anon Postgres role. Any
+ * RLS policy scoped to auth.uid() (e.g. "Users can read own record" on
+ * public.users, USING (auth.uid() = id)) then filters out the row with
+ * ZERO error -- not a thrown exception, just an empty result -- which is
+ * what silently demoted every account, including real admins, to
+ * role='client' and bounced them to /pricing.
+ *
+ * app/api/auth/signup/route.ts already does this correctly (calls
+ * .auth.setSession() on an @supabase/ssr client right after getting a real
+ * access/refresh token pair). This is the same fix, extracted so every
+ * session-establishing entry point (signin, password-reset recovery
+ * exchange) can call it identically instead of drifting apart.
+ *
+ * Deliberately additive, not a replacement: setSessionCookies()'s raw-JWT
+ * cookie stays in place for wrapGetUser()'s local-verification shortcut.
+ * This just also gives the real @supabase/ssr client something valid to
+ * work with, via its own setAll() cookie writer.
+ */
+export async function establishSupabaseSession(accessToken: string, refreshToken: string) {
+  const cookieStore = await cookies()
+  const ssrClient = createServerClient(
+    process.env.NEXT_PUBLIC_SUPABASE_URL!,
+    process.env.NEXT_PUBLIC_SUPABASE_ANON_KEY!,
+    {
+      cookies: {
+        getAll() {
+          return cookieStore.getAll()
+        },
+        setAll(cookiesToSet) {
+          cookiesToSet.forEach(({ name, value, options }) => {
+            try {
+              cookieStore.set(name, value, options)
+            } catch {}
+          })
+        },
+      },
+    }
+  )
+
+  try {
+    await ssrClient.auth.setSession({
+      access_token: accessToken,
+      refresh_token: refreshToken,
+    })
+  } catch (err) {
+    console.error(
+      '[auth] @supabase/ssr setSession failed -- RLS-scoped reads will silently return empty rows instead of erroring:',
+      (err as Error).message
+    )
+  }
+}
