diff --git a/lib/with-timeout.ts b/lib/with-timeout.ts
new file mode 100644
index 0000000..dc5e2c2
--- /dev/null
+++ b/lib/with-timeout.ts
@@ -0,0 +1,24 @@
+// Shared timeout guard for Supabase/PostgREST calls against the self-hosted
+// backend. Mirrors the pattern lib/supabase/middleware.ts's getUserWithTimeout
+// already uses for supabase.auth.getUser() (see login_hang_fix.patch) -- a
+// hung self-hosted PostgREST/Kong call must never hang a request indefinitely.
+//
+// Used by proxy.ts and app/dashboard/layout.tsx to guard their users-table
+// role lookups, which previously had NO timeout and NO error handling at
+// all: a failed/hung/RLS-denied call silently resolved to `data: undefined`
+// and got treated as "role not found," defaulting real admin accounts to
+// role='client' with zero visible error anywhere. See HOTFIX_role_lookup
+// notes for the incident this was written for.
+export async function withTimeout<T>(promise: Promise<T>, ms: number, label: string): Promise<T> {
+  let timer: ReturnType<typeof setTimeout> | undefined
+  try {
+    return await Promise.race([
+      promise,
+      new Promise<never>((_, reject) => {
+        timer = setTimeout(() => reject(new Error(`${label} timed out after ${ms}ms`)), ms)
+      }),
+    ])
+  } finally {
+    if (timer) clearTimeout(timer)
+  }
+}
