{
  "id": "clientRegId6AbCdEfGhIj",
  "name": "WF6 — Client Registration",
  "nodes": [
    {
      "id": "a1b2c3d4-e5f6-7890-abcd-ef1234567801",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.2,
      "position": [250, 300],
      "parameters": {
        "path": "client-register",
        "httpMethod": "POST",
        "responseMode": "lastNode",
        "options": {}
      },
      "webhookId": "client-register"
    },
    {
      "id": "a1b2c3d4-e5f6-7890-abcd-ef1234567802",
      "name": "Validate & Normalize",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [450, 300],
      "parameters": {
        "values": {
          "string": [
            { "name": "auth_user_id", "value": "={{ $json.auth_user_id }}" },
            { "name": "email", "value": "={{ $json.email.toLowerCase() }}" },
            { "name": "full_name", "value": "={{ $json.full_name || $json.email.split('@')[0] }}" },
            { "name": "role", "value": "={{ $json.role || 'client' }}" },
            { "name": "source", "value": "={{ $json.source || 'webhook' }}" }
          ]
        },
        "options": {}
      },
      "credentials": {}
    },
    {
      "id": "a1b2c3d4-e5f6-7890-abcd-ef1234567803",
      "name": "Ensure Organization",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [650, 300],
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO public.organizations (id, name, owner_id, status)\nVALUES (\n  '{{ $json.auth_user_id }}'::uuid,\n  '{{ $json.full_name }}',\n  '{{ $json.auth_user_id }}'::uuid,\n  'active'\n)\nON CONFLICT (id) DO UPDATE SET\n  name = EXCLUDED.name\nRETURNING id;",
        "options": {}
      },
      "credentials": {
        "postgres": { "id": "V3Efv1mtgcNnSJUZ", "name": "Supabase Postgres" }
      }
    },
    {
      "id": "a1b2c3d4-e5f6-7890-abcd-ef1234567804",
      "name": "Upsert Client",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [850, 200],
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO public.clients (id, full_name, email, metadata)\nVALUES (\n  '{{ $json.auth_user_id }}'::uuid,\n  '{{ $json.full_name }}',\n  '{{ $json.email }}',\n  '{\"registration_source\": \"{{ $json.source }}\", \"role\": \"{{ $json.role }}\"}'::jsonb\n)\nON CONFLICT (id) DO UPDATE SET\n  full_name = EXCLUDED.full_name,\n  email = EXCLUDED.email\nRETURNING id;",
        "options": {}
      },
      "credentials": {
        "postgres": { "id": "V3Efv1mtgcNnSJUZ", "name": "Supabase Postgres" }
      }
    },
    {
      "id": "a1b2c3d4-e5f6-7890-abcd-ef1234567805",
      "name": "Create Client Twin",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [850, 400],
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO public.client_twins (client_id, organization_id, twin_status, version, confidence_score)\nVALUES (\n  '{{ $json.auth_user_id }}'::uuid,\n  '{{ $json.auth_user_id }}'::uuid,\n  'active',\n  1,\n  0.5\n)\nON CONFLICT (client_id) DO UPDATE SET\n  twin_status = 'active',\n  confidence_score = 0.5\nRETURNING id;",
        "options": {}
      },
      "credentials": {
        "postgres": { "id": "V3Efv1mtgcNnSJUZ", "name": "Supabase Postgres" }
      }
    },
    {
      "id": "a1b2c3d4-e5f6-7890-abcd-ef1234567806",
      "name": "Build Response",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [1050, 300],
      "parameters": {
        "values": {
          "string": [
            { "name": "status", "value": "success" },
            { "name": "client_id", "value": "={{ $json.auth_user_id }}" },
            { "name": "email", "value": "={{ $json.email }}" }
          ]
        },
        "options": {}
      },
      "credentials": {}
    },
    {
      "id": "a1b2c3d4-e5f6-7890-abcd-ef1234567807",
      "name": "Webhook Response",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1250, 300],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ {\n  \"status\": \"success\",\n  \"client_id\": $json.client_id,\n  \"email\": $json.email,\n  \"message\": \"Client registered successfully\"\n} }}"
      }
    }
  ],
  "connections": {
    "Webhook": {
      "main": [[{"node": "Validate & Normalize", "type": "main", "index": 0}]]
    },
    "Validate & Normalize": {
      "main": [[{"node": "Ensure Organization", "type": "main", "index": 0}]]
    },
    "Ensure Organization": {
      "main": [[{"node": "Upsert Client", "type": "main", "index": 0}, {"node": "Create Client Twin", "type": "main", "index": 0}]]
    },
    "Upsert Client": {
      "main": [[{"node": "Build Response", "type": "main", "index": 0}]]
    },
    "Create Client Twin": {
      "main": [[{"node": "Build Response", "type": "main", "index": 0}]]
    },
    "Build Response": {
      "main": [[{"node": "Webhook Response", "type": "main", "index": 0}]]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "callerPolicy": "workflowsFromSameOwner",
    "timezone": "UTC"
  },
  "staticData": null,
  "tags": [],
  "active": false
}
