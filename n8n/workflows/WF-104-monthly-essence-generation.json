{
  "name": "WF-104 \u2014 Monthly Essence Board Generation",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 4 1 * *"
            }
          ]
        }
      },
      "id": "trigger-1",
      "name": "Monthly 1st 04:00 UTC",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -1120,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{$env.SUPABASE_URL}}/rest/v1/clients?select=id&status=eq.active",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "options": {}
      },
      "id": "fetch-clients",
      "name": "Fetch Active Clients",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -880,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "PLACEHOLDER_SUPABASE_SERVICE_ROLE",
          "name": "Supabase Service Role"
        }
      },
      "notes": "Header auth credential must send: apikey=<SUPABASE_SERVICE_ROLE_KEY>, Authorization=Bearer <SUPABASE_SERVICE_ROLE_KEY>"
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "id": "split-batches",
      "name": "One Client At A Time",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        -640,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.NIORE_APP_URL}}/api/zuri/essence",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "userId",
              "value": "={{$json.id}}"
            },
            {
              "name": "range",
              "value": "monthly"
            }
          ]
        },
        "options": {
          "timeout": 30000
        },
        "headerParameters": {
          "parameters": [
            {
              "name": "x-internal-cron-secret",
              "value": "={{$env.INTERNAL_CRON_SECRET}}"
            }
          ]
        },
        "sendHeaders": true
      },
      "id": "generate-essence",
      "name": "Generate Monthly Essence",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -400,
        220
      ],
      "onError": "continueRegularOutput",
      "notes": "/api/zuri/essence requires either a matching session or the x-internal-cron-secret header (fixed earlier this session) -- this call authenticates via that header, same as WF-102."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.SUPABASE_URL}}/rest/v1/workflow_run_logs",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "workflow_id",
              "value": "={{$env.WF_104_ROW_ID}}"
            },
            {
              "name": "client_id",
              "value": "={{$json.id}}"
            },
            {
              "name": "status",
              "value": "={{$json.error ? 'failed' : 'completed'}}"
            },
            {
              "name": "triggered_by",
              "value": "schedule"
            },
            {
              "name": "started_at",
              "value": "={{$now.toISO()}}"
            },
            {
              "name": "completed_at",
              "value": "={{$now.toISO()}}"
            }
          ]
        }
      },
      "id": "log-result",
      "name": "Log Per-Client Result",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -160,
        220
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "PLACEHOLDER_SUPABASE_SERVICE_ROLE",
          "name": "Supabase Service Role"
        }
      }
    }
  ],
  "connections": {
    "Monthly 1st 04:00 UTC": {
      "main": [
        [
          {
            "node": "Fetch Active Clients",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Active Clients": {
      "main": [
        [
          {
            "node": "One Client At A Time",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "One Client At A Time": {
      "main": [
        [
          {
            "node": "Generate Monthly Essence",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    },
    "Generate Monthly Essence": {
      "main": [
        [
          {
            "node": "Log Per-Client Result",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Log Per-Client Result": {
      "main": [
        [
          {
            "node": "One Client At A Time",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "meta": {
    "templateId": "WF-104"
  }
}