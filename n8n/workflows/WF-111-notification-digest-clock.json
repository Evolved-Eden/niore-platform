{
  "name": "WF-111 — Notification Digest Dispatch (Clock)",
  "nodes": [
    {
      "parameters": {
        "rule": { "interval": [ { "field": "cronExpression", "expression": "0 7 * * *" } ] }
      },
      "id": "daily-0700",
      "name": "Daily 07:00 UTC",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [-420, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.NIORE_APP_URL}}/api/internal/notifications/digest",
        "authentication": "none",
        "sendHeaders": true,
        "headerParameters": { "parameters": [
          { "name": "x-internal-cron-secret", "value": "={{$env.INTERNAL_CRON_SECRET}}" }
        ] },
        "options": { "timeout": 120000 }
      },
      "id": "call-digest",
      "name": "Dispatch Daily Digests",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-160, 300]
    }
  ],
  "connections": {
    "Daily 07:00 UTC": { "main": [[{ "node": "Dispatch Daily Digests", "type": "main", "index": 0 }]] }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "meta": { "templateId": "WF-111" }
}
