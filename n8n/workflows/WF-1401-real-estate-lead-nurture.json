{
  "name": "WF-1401 — Real Estate: Lead Nurture & Qualification",
  "nodes": [
    {
      "parameters": { "rule": { "interval": [ { "field": "cronExpression", "expression": "0 */4 * * *" } ] } },
      "id": "trigger-1", "name": "Every 4 Hours",
      "type": "n8n-nodes-base.scheduleTrigger", "typeVersion": 1.2, "position": [-1300, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{$env.SUPABASE_URL}}/rest/v1/organization_os_activations?select=organization_id&item_type=eq.vertical_pack&item_key=eq.real_estate_land&state=eq.active",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth"
      },
      "id": "fetch-orgs", "name": "Fetch Orgs With Real Estate Pack Active",
      "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [-1060, 300],
      "credentials": { "httpHeaderAuth": { "id": "PLACEHOLDER_SUPABASE_SERVICE_ROLE", "name": "Supabase Service Role" } }
    },
    {
      "parameters": {
        "jsCode": "const ids = $input.all().map(i => i.json.organization_id).filter(Boolean);\nif (ids.length === 0) return [];\nreturn [{ json: { org_ids: ids.join(',') } }];"
      },
      "id": "build-org-filter", "name": "Build Org ID Filter",
      "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [-820, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{$env.SUPABASE_URL}}/rest/v1/clients?select=id,full_name,organization_id&organization_id=in.({{$json.org_ids}})&primary_vertical=eq.real_estate&status=eq.active&lifecycle_stage=eq.lead",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth"
      },
      "id": "fetch-leads", "name": "Fetch Leads (lifecycle_stage=lead)",
      "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [-580, 300],
      "credentials": { "httpHeaderAuth": { "id": "PLACEHOLDER_SUPABASE_SERVICE_ROLE", "name": "Supabase Service Role" } },
      "notes": "lifecycle_stage vocabulary for the Real Estate Pack: lead -> qualified -> searching -> under_contract -> closed. Defined by this workflow set (WF-1401..1406) since clients.lifecycle_stage is free text with no prior enum."
    },
    { "parameters": { "batchSize": 1, "options": {} }, "id": "split-1", "name": "One Lead At A Time",
      "type": "n8n-nodes-base.splitInBatches", "typeVersion": 3, "position": [-340, 300] },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.NIORE_APP_URL}}/api/internal/verticals/run-agent",
        "sendHeaders": true,
        "headerParameters": { "parameters": [ { "name": "x-internal-secret", "value": "={{$env.INTERNAL_CRON_SECRET}}" } ] },
        "sendBody": true,
        "bodyParameters": { "parameters": [
          { "name": "clientId", "value": "={{$json.id}}" },
          { "name": "agentId", "value": "AGT-010" },
          { "name": "actionType", "value": "real_estate_lead_nurture" },
          { "name": "prompt", "value": "=Nurture and qualify this real estate lead: {{$json.full_name}}. Summarize their likely readiness to move forward and suggest the next best follow-up action." }
        ] },
        "options": { "timeout": 45000 }
      },
      "id": "run-agent", "name": "Run Lead Nurture Agent (AGT-010)",
      "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [-100, 220],
      "onError": "continueRegularOutput",
      "notes": "No published agent is literally named 'Lead Nurture Agent' -- mapped to AGT-010 (Client Experience Agent), the closest real published real_estate-vertical agent for prospect relationship work."
    }
  ],
  "connections": {
    "Every 4 Hours": { "main": [[{ "node": "Fetch Orgs With Real Estate Pack Active", "type": "main", "index": 0 }]] },
    "Fetch Orgs With Real Estate Pack Active": { "main": [[{ "node": "Build Org ID Filter", "type": "main", "index": 0 }]] },
    "Build Org ID Filter": { "main": [[{ "node": "Fetch Leads (lifecycle_stage=lead)", "type": "main", "index": 0 }]] },
    "Fetch Leads (lifecycle_stage=lead)": { "main": [[{ "node": "One Lead At A Time", "type": "main", "index": 0 }]] },
    "One Lead At A Time": { "main": [[{ "node": "Run Lead Nurture Agent (AGT-010)", "type": "main", "index": 0 }], []] },
    "Run Lead Nurture Agent (AGT-010)": { "main": [[{ "node": "One Lead At A Time", "type": "main", "index": 0 }]] }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "meta": { "templateId": "WF-1401" }
}
