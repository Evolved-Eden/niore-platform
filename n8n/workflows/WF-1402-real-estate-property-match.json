{
  "name": "WF-1402 — Real Estate: Property Match Intelligence",
  "nodes": [
    {
      "parameters": { "rule": { "interval": [ { "field": "cronExpression", "expression": "0 8 * * *" } ] } },
      "id": "trigger-1", "name": "Daily 8am",
      "type": "n8n-nodes-base.scheduleTrigger", "typeVersion": 1.2, "position": [-1300, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{$env.SUPABASE_URL}}/rest/v1/organization_os_activations?select=organization_id&item_type=eq.vertical_pack&item_key=eq.real_estate_land&state=eq.active",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth"
      },
      "id": "fetch-orgs", "name": "Fetch Orgs With Real Estate Pack Active",
      "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [-1060, 300],
      "credentials": { "httpHeaderAuth": { "id": "PLACEHOLDER_SUPABASE_SERVICE_ROLE", "name": "Supabase Service Role" } }
    },
    {
      "parameters": {
        "jsCode": "const ids = $input.all().map(i => i.json.organization_id).filter(Boolean);\nif (ids.length === 0) return [];\nreturn [{ json: { org_ids: ids.join(',') } }];"
      },
      "id": "build-org-filter", "name": "Build Org ID Filter",
      "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [-820, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{$env.SUPABASE_URL}}/rest/v1/clients?select=id,full_name,organization_id,metadata&organization_id=in.({{$json.org_ids}})&primary_vertical=eq.real_estate&status=eq.active&lifecycle_stage=eq.searching",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth"
      },
      "id": "fetch-searching", "name": "Fetch Clients Actively Searching",
      "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [-580, 300],
      "credentials": { "httpHeaderAuth": { "id": "PLACEHOLDER_SUPABASE_SERVICE_ROLE", "name": "Supabase Service Role" } }
    },
    { "parameters": { "batchSize": 1, "options": {} }, "id": "split-1", "name": "One Client At A Time",
      "type": "n8n-nodes-base.splitInBatches", "typeVersion": 3, "position": [-340, 300] },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.NIORE_APP_URL}}/api/internal/verticals/run-agent",
        "sendHeaders": true,
        "headerParameters": { "parameters": [ { "name": "x-internal-secret", "value": "={{$env.INTERNAL_CRON_SECRET}}" } ] },
        "sendBody": true,
        "bodyParameters": { "parameters": [
          { "name": "clientId", "value": "={{$json.id}}" },
          { "name": "agentId", "value": "property_match" },
          { "name": "actionType", "value": "real_estate_property_match" },
          { "name": "prompt", "value": "=Find and rank the best-fit property matches for {{$json.full_name}} based on their stored preferences: {{JSON.stringify($json.metadata || {})}}." }
        ] },
        "options": { "timeout": 45000 }
      },
      "id": "run-agent", "name": "Run Property Match Intelligence Agent",
      "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [-100, 220],
      "onError": "continueRegularOutput",
      "notes": "agent_id 'property_match' is a real published CROSS_SYSTEM agent (Property Match Intelligence) -- exact name match, no substitution needed."
    }
  ],
  "connections": {
    "Daily 8am": { "main": [[{ "node": "Fetch Orgs With Real Estate Pack Active", "type": "main", "index": 0 }]] },
    "Fetch Orgs With Real Estate Pack Active": { "main": [[{ "node": "Build Org ID Filter", "type": "main", "index": 0 }]] },
    "Build Org ID Filter": { "main": [[{ "node": "Fetch Clients Actively Searching", "type": "main", "index": 0 }]] },
    "Fetch Clients Actively Searching": { "main": [[{ "node": "One Client At A Time", "type": "main", "index": 0 }]] },
    "One Client At A Time": { "main": [[{ "node": "Run Property Match Intelligence Agent", "type": "main", "index": 0 }], []] },
    "Run Property Match Intelligence Agent": { "main": [[{ "node": "One Client At A Time", "type": "main", "index": 0 }]] }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "meta": { "templateId": "WF-1402" }
}
