{
  "name": "WF-401 — Post-Deploy Health Check",
  "nodes": [
    {
      "parameters": { "httpMethod": "POST", "path": "vercel-deploy-webhook", "responseMode": "onReceived" },
      "id": "webhook-1", "name": "Vercel Deploy Webhook",
      "type": "n8n-nodes-base.webhook", "typeVersion": 2, "position": [-1100, 300],
      "notes": "Configure this URL as a Deploy Hook / Integration webhook in the Vercel project settings for production deployment.succeeded events."
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{$env.NIORE_APP_URL}}/",
        "options": { "timeout": 10000, "response": { "response": { "fullResponse": true } } }
      },
      "id": "check-home", "name": "Check Home Page",
      "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [-860, 220],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{$env.NIORE_APP_URL}}/api/agents",
        "options": { "timeout": 10000, "response": { "response": { "fullResponse": true } } }
      },
      "id": "check-agents-api", "name": "Check /api/agents",
      "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [-860, 380],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const results = $input.all();\nconst failures = results.filter(r => !r.json.statusCode || r.json.statusCode >= 400).map(r => r.json.headers?.['x-matched-path'] || 'unknown route');\nreturn [{ json: { failures, healthy: failures.length === 0 } }];"
      },
      "id": "evaluate", "name": "Evaluate Results",
      "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [-620, 300]
    },
    {
      "parameters": { "conditions": { "boolean": [ { "value1": "={{!$json.healthy}}", "value2": true } ] } },
      "id": "if-unhealthy", "name": "If Any Route Failed",
      "type": "n8n-nodes-base.if", "typeVersion": 2, "position": [-380, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.INTERNAL_OPS_DISCORD_WEBHOOK}}",
        "sendBody": true,
        "bodyParameters": { "parameters": [ { "name": "content", "value": "=🚨 Post-deploy health check failed: {{$json.failures.join(', ')}}" } ] }
      },
      "id": "alert", "name": "Alert Ops Channel",
      "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [-140, 220]
    }
  ],
  "connections": {
    "Vercel Deploy Webhook": { "main": [[{ "node": "Check Home Page", "type": "main", "index": 0 }, { "node": "Check /api/agents", "type": "main", "index": 0 }]] },
    "Check Home Page": { "main": [[{ "node": "Evaluate Results", "type": "main", "index": 0 }]] },
    "Check /api/agents": { "main": [[{ "node": "Evaluate Results", "type": "main", "index": 0 }]] },
    "Evaluate Results": { "main": [[{ "node": "If Any Route Failed", "type": "main", "index": 0 }]] },
    "If Any Route Failed": { "main": [[{ "node": "Alert Ops Channel", "type": "main", "index": 0 }], []] }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "meta": { "templateId": "WF-401" }
}
