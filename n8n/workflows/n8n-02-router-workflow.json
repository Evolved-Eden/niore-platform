{
  "name": "n8n Router Workflow (Shared Core)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "responseMode": "onReceived"
      },
      "id": "wh-router",
      "name": "Entity Dispatch",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
