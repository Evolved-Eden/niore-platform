            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Task Respond",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Has Agent": {
      "main": [
        [
          {
            "node": "Run Task Agent",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Log Manual Task",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run Task Agent": {
      "main": [
        [
          {
            "node": "Collect Results",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Log Manual Task": {
      "main": [
        [
          {
            "node": "Collect Results",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Collect Results": {
      "main": [
        [
          {
            "node": "One Task At A Time",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Task Respond": {
      "main": [
        []
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "meta": {
    "templateId": "n8n_task_workflow"
  }
}